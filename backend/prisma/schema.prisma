generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  password              String
  firstName             String
  lastName              String
  phone                 String?
  role                  UserRole
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  announcementsCreated  Announcement[]        @relation("AnnouncementCreator")
  assignedComplaints    ComplaintAssignment[] @relation("AssignedStaff")
  handledEmergencies    Emergency[]           @relation("EmergencyHandler")
  handledHealthRequests HealthRequest[]       @relation("HealthRequestHandler")
  student               Student?

  @@map("users")
}

model College {
  id              String           @id @default(uuid())
  name            String
  address         String?
  email           String?
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  hostelBuildings HostelBuilding[]

  @@map("colleges")
}

model HostelBuilding {
  id            String         @id @default(uuid())
  collegeId     String
  name          String
  code          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  blocks        Block[]
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, code])
  @@map("hostel_buildings")
}

model Block {
  id               String         @id @default(uuid())
  hostelBuildingId String
  name             String
  type             BlockType
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  announcements    Announcement[]
  hostelBuilding   HostelBuilding @relation(fields: [hostelBuildingId], references: [id], onDelete: Cascade)
  floors           Floor[]

  @@unique([hostelBuildingId, name])
  @@map("blocks")
}

model Floor {
  id          String   @id @default(uuid())
  blockId     String
  floorNumber Int
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  block       Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms       Room[]

  @@unique([blockId, floorNumber])
  @@map("floors")
}

model Room {
  id          String           @id @default(uuid())
  floorId     String
  roomNumber  String
  capacity    Int              @default(3)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  complaints  Complaint[]
  allocations RoomAllocation[]
  floor       Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model Student {
  id              String           @id @default(uuid())
  userId          String           @unique
  studentNumber   String           @unique
  gender          Gender           @map("Gender")
  department      String?
  course          String?
  year            Int?
  status          StudentStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  complaints      Complaint[]
  emergencies     Emergency[]
  healthRequests  HealthRequest[]
  parentContacts  ParentContact[]
  roomAllocations RoomAllocation[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model ParentContact {
  id                 String  @id @default(uuid())
  studentId          String
  name               String
  relationship       String
  phone              String
  email              String?
  isPrimary          Boolean @default(false)
  isEmergencyContact Boolean @default(false)

  // Parent phone verification
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  // Admin approval workflow
  status          ParentContactStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?

  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  student          Student                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  notifications    ParentNotification[]
  otpVerifications ParentContactOtpVerification[]

  @@index([studentId])
  @@index([phone])
  @@index([status])
  @@map("parent_contacts")
}

model ParentContactOtpVerification {
  id              String    @id @default(uuid())
  parentContactId String
  otpHash         String
  expiresAt       DateTime
  attempts        Int       @default(0)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parentContact ParentContact @relation(fields: [parentContactId], references: [id], onDelete: Cascade)

  @@index([parentContactId])
  @@index([expiresAt])
  @@map("parent_contact_otp_verifications")
}

model RoomAllocation {
  id          String               @id @default(uuid())
  studentId   String
  roomId      String
  allocatedAt DateTime             @default(now())
  vacatedAt   DateTime?
  status      RoomAllocationStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  room        Room                 @relation(fields: [roomId], references: [id])
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("room_allocations")
}

model ComplaintCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  complaints  Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id            String                   @id @default(uuid())
  complaintNo   String                   @unique
  studentId     String
  categoryId    String
  roomId        String
  title         String
  description   String
  priority      ComplaintPriority        @default(MEDIUM)
  status        ComplaintStatus          @default(OPEN)
  cancelledAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  assignments   ComplaintAssignment[]
  attachments   ComplaintAttachment[]
  feedback      ComplaintFeedback?
  resolution    ComplaintResolution?
  statusHistory ComplaintStatusHistory[]
  category      ComplaintCategory        @relation(fields: [categoryId], references: [id])
  room          Room                     @relation(fields: [roomId], references: [id])
  student       Student                  @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([categoryId])
  @@index([roomId])
  @@index([status])
  @@map("complaints")
}

model ComplaintAttachment {
  id          String                  @id @default(uuid())
  complaintId String
  fileUrl     String
  fileName    String
  fileType    ComplaintAttachmentType
  createdAt   DateTime                @default(now())
  complaint   Complaint               @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_attachments")
}

model ComplaintAssignment {
  id            String    @id @default(uuid())
  complaintId   String
  assignedTo    String
  assignedBy    String
  assignedAt    DateTime  @default(now())
  unassignedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  assignedStaff User      @relation("AssignedStaff", fields: [assignedTo], references: [id])
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([assignedTo])
  @@map("complaint_assignments")
}

model ComplaintStatusHistory {
  id          String           @id @default(uuid())
  complaintId String
  oldStatus   ComplaintStatus?
  newStatus   ComplaintStatus
  changedBy   String
  remarks     String?
  createdAt   DateTime         @default(now())
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_status_history")
}

model ComplaintResolution {
  id             String    @id @default(uuid())
  complaintId    String    @unique
  resolvedBy     String
  resolutionNote String
  resolvedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_resolutions")
}

model ComplaintFeedback {
  id          String    @id @default(uuid())
  complaintId String    @unique
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_feedback")
}

model HealthRequest {
  id          String              @id @default(uuid())
  studentId   String
  requestType HealthRequestType
  description String
  priority    HealthPriority      @default(NORMAL)
  status      HealthRequestStatus @default(REPORTED)
  handledById String?
  reportedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  emergency   Emergency?
  handledBy   User?               @relation("HealthRequestHandler", fields: [handledById], references: [id])
  student     Student             @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("health_requests")
}

model Emergency {
  id                  String               @id @default(uuid())
  healthRequestId     String               @unique
  studentId           String
  severity            EmergencySeverity
  description         String
  status              EmergencyStatus      @default(ACTIVE)
  handledById         String?
  reportedById        String
  parentNotified      Boolean              @default(false)
  reportedAt          DateTime             @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  handledBy           User?                @relation("EmergencyHandler", fields: [handledById], references: [id])
  healthRequest       HealthRequest        @relation(fields: [healthRequestId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id])
  parentNotifications ParentNotification[]

  @@index([studentId])
  @@index([status])
  @@map("emergencies")
}

model ParentNotification {
  id               String                   @id @default(uuid())
  emergencyId      String
  parentContactId  String
  notificationType ParentNotificationType
  status           ParentNotificationStatus @default(PENDING)
  sentAt           DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  emergency        Emergency                @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  parentContact    ParentContact            @relation(fields: [parentContactId], references: [id])

  @@index([emergencyId])
  @@index([parentContactId])
  @@map("parent_notifications")
}

model Announcement {
  id               String               @id @default(uuid())
  title            String
  message          String
  audience         AnnouncementAudience @default(ALL)
  priority         AnnouncementPriority @default(NORMAL)
  hostelBuildingId String?
  blockId          String?
  createdById      String
  isActive         Boolean              @default(true)
  expiresAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  block            Block?               @relation(fields: [blockId], references: [id])
  createdBy        User                 @relation("AnnouncementCreator", fields: [createdById], references: [id])
  hostelBuilding   HostelBuilding?      @relation(fields: [hostelBuildingId], references: [id])

  @@index([audience])
  @@index([hostelBuildingId])
  @@index([blockId])
  @@index([isActive])
  @@map("announcements")
}

enum UserRole {
  STUDENT
  WARDEN
  MAINTENANCE_STAFF
  ADMIN
}

enum BlockType {
  BOYS
  GIRLS
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
  GRADUATED
}

enum RoomAllocationStatus {
  ACTIVE
  VACATED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintAttachmentType {
  IMAGE
  VIDEO
}

enum HealthRequestType {
  ILLNESS
  INJURY
  MEDICAL_ASSISTANCE
  EMERGENCY
  OTHER
}

enum HealthPriority {
  NORMAL
  HIGH
  EMERGENCY
}

enum HealthRequestStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EmergencySeverity {
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum ParentContactStatus {
  PENDING
  PHONE_VERIFIED
  APPROVED
  REJECTED
}

enum ParentNotificationType {
  SMS
  PUSH
  EMAIL
}

enum ParentNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AnnouncementAudience {
  ALL
  BOYS
  GIRLS
  SPECIFIC_BUILDING
  SPECIFIC_BLOCK
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}
