generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  WARDEN
  MAINTENANCE_STAFF
  ADMIN
}

enum BlockType {
  BOYS
  GIRLS
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum RoomAllocationStatus {
  ACTIVE
  VACATED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintAttachmentType {
  IMAGE
  VIDEO
}

enum HealthRequestType {
  ILLNESS
  INJURY
  MEDICAL_ASSISTANCE
  EMERGENCY
  OTHER
}

enum HealthPriority {
  NORMAL
  HIGH
  EMERGENCY
}

enum HealthRequestStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EmergencySeverity {
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum ParentNotificationType {
  SMS
  PUSH
  EMAIL
}

enum ParentNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AnnouncementAudience {
  ALL
  BOYS
  GIRLS
  SPECIFIC_BUILDING
  SPECIFIC_BLOCK
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?

  assignedComplaints  ComplaintAssignment[] @relation("AssignedStaff")

  handledHealthRequests HealthRequest[] @relation("HealthRequestHandler")
  handledEmergencies    Emergency[]     @relation("EmergencyHandler")
  
  announcementsCreated Announcement[] @relation("AnnouncementCreator")

  @@map("users")
}

model College {
  id        String   @id @default(uuid())
  name      String
  address   String?
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostelBuildings HostelBuilding[]

  @@map("colleges")
}

model HostelBuilding {
  id          String   @id @default(uuid())
  collegeId   String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  blocks  Block[]

  announcements Announcement[]

  @@unique([collegeId, code])
  @@map("hostel_buildings")
}

model Block {
  id               String    @id @default(uuid())
  hostelBuildingId String
  name             String
  type             BlockType
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hostelBuilding HostelBuilding @relation(fields: [hostelBuildingId], references: [id], onDelete: Cascade)
  floors          Floor[]

  announcements Announcement[]

  @@unique([hostelBuildingId, name])
  @@map("blocks")
}

model Floor {
  id          String   @id @default(uuid())
  blockId     String
  floorNumber Int
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@unique([blockId, floorNumber])
  @@map("floors")
}

model Room {
  id         String   @id @default(uuid())
  floorId    String
  roomNumber String
  capacity   Int      @default(3)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  allocations RoomAllocation[]

  complaints Complaint[]

  @@unique([floorId, roomNumber])
  @@map("rooms")
}


model Student {
  id            String        @id @default(uuid())
  userId        String        @unique
  studentNumber String        @unique
  department    String?
  course        String?
  year          Int?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentContacts ParentContact[]
  roomAllocations RoomAllocation[]

  complaints Complaint[]

  healthRequests HealthRequest[]
  emergencies    Emergency[]

  @@map("students")
}

model ParentContact {
  id                 String   @id @default(uuid())
  studentId          String
  name               String
  relationship       String
  phone              String
  email              String?
  isPrimary          Boolean  @default(false)
  isEmergencyContact Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  notifications ParentNotification[]

  @@map("parent_contacts")
}

model RoomAllocation {
  id          String               @id @default(uuid())
  studentId   String
  roomId      String
  allocatedAt DateTime             @default(now())
  vacatedAt   DateTime?
  status      RoomAllocationStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@map("room_allocations")
}

model ComplaintCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id          String            @id @default(uuid())
  complaintNo String            @unique
  studentId   String
  categoryId  String
  roomId      String
  title       String
  description String
  priority    ComplaintPriority @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  cancelledAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  student  Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  category ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  room     Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)

  attachments     ComplaintAttachment[]
  assignments     ComplaintAssignment[]
  statusHistory   ComplaintStatusHistory[]
  resolution      ComplaintResolution?
  feedback        ComplaintFeedback?

  @@index([studentId])
  @@index([categoryId])
  @@index([roomId])
  @@index([status])
  @@map("complaints")
}

model ComplaintAttachment {
  id          String                  @id @default(uuid())
  complaintId String
  fileUrl     String
  fileName    String
  fileType    ComplaintAttachmentType
  createdAt   DateTime                @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_attachments")
}

model ComplaintAssignment {
  id          String   @id @default(uuid())
  complaintId String
  assignedTo  String
  assignedBy  String
  assignedAt  DateTime @default(now())
  unassignedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  assignedStaff User @relation("AssignedStaff",fields: [assignedTo],references: [id],onDelete: Restrict)

  @@index([complaintId])
  @@index([assignedTo])
  @@map("complaint_assignments")
}

model ComplaintStatusHistory {
  id          String          @id @default(uuid())
  complaintId String
  oldStatus   ComplaintStatus?
  newStatus   ComplaintStatus
  changedBy   String
  remarks     String?
  createdAt   DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_status_history")
}

model ComplaintResolution {
  id              String   @id @default(uuid())
  complaintId     String   @unique
  resolvedBy      String
  resolutionNote  String
  resolvedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_resolutions")
}

model ComplaintFeedback {
  id          String   @id @default(uuid())
  complaintId String   @unique
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_feedback")
}

model HealthRequest {
  id          String              @id @default(uuid())
  studentId   String
  requestType HealthRequestType
  description String
  priority    HealthPriority      @default(NORMAL)
  status      HealthRequestStatus @default(REPORTED)
  handledById String?
  reportedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  handledBy User?   @relation("HealthRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  emergency Emergency?

  @@index([studentId])
  @@index([status])
  @@map("health_requests")
}

model Emergency {
  id              String          @id @default(uuid())
  healthRequestId String          @unique
  studentId       String
  severity        EmergencySeverity
  description     String
  status          EmergencyStatus @default(ACTIVE)
  handledById     String?
  reportedById    String
  parentNotified  Boolean         @default(false)
  reportedAt      DateTime        @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  healthRequest HealthRequest @relation(fields: [healthRequestId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  handledBy     User?         @relation("EmergencyHandler", fields: [handledById], references: [id], onDelete: SetNull)

  parentNotifications ParentNotification[]

  @@index([studentId])
  @@index([status])
  @@map("emergencies")
}

model ParentNotification {
  id              String                   @id @default(uuid())
  emergencyId     String
  parentContactId String
  notificationType ParentNotificationType
  status          ParentNotificationStatus @default(PENDING)
  sentAt          DateTime?
  deliveredAt     DateTime?
  failureReason   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  emergency     Emergency     @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  parentContact ParentContact @relation(fields: [parentContactId], references: [id], onDelete: Restrict)

  @@index([emergencyId])
  @@index([parentContactId])
  @@map("parent_notifications")
}

model Announcement {
  id                String               @id @default(uuid())
  title             String
  message           String
  audience          AnnouncementAudience @default(ALL)
  priority          AnnouncementPriority @default(NORMAL)

  hostelBuildingId  String?
  blockId           String?
  createdById       String

  isActive          Boolean              @default(true)
  expiresAt         DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  hostelBuilding HostelBuilding? @relation(fields: [hostelBuildingId], references: [id], onDelete: SetNull)
  block          Block?          @relation(fields: [blockId], references: [id], onDelete: SetNull)

  createdBy User @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([audience])
  @@index([hostelBuildingId])
  @@index([blockId])
  @@index([isActive])
  @@map("announcements")
}